<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Backup is off.

      Android's default would sync app-private storage to the account's Drive —
      including the widget snapshot, which holds a photo they sent. Unpair and
      account deletion promise a delete that actually deletes, and a copy in
      someone's cloud backup that neither partner knows about would make that
      untrue. The data is all recoverable from Supabase on a reinstall anyway.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          The six widgets.

          `exported="true"` is required — the launcher is a different process and
          has to be able to bind these. It is not a hole: a receiver only ever
          reads the snapshot this app wrote for it, and the snapshot holds a day
          count, a streak and a first name. No token, no coordinate, no photo
          path that resolves outside this app's own storage.
        -->
        <receiver
            android:name=".widget.SnapsReceiver"
            android:label="@string/widget_snaps_description"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_snaps" />
        </receiver>

        <receiver
            android:name=".widget.CanvasReceiver"
            android:label="@string/widget_canvas_description"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_canvas" />
        </receiver>

        <receiver
            android:name=".widget.AnniversaryReceiver"
            android:label="@string/widget_anniversary_description"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_anniversary" />
        </receiver>

        <receiver
            android:name=".widget.CountdownReceiver"
            android:label="@string/widget_countdown_description"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown" />
        </receiver>

        <receiver
            android:name=".widget.StreakReceiver"
            android:label="@string/widget_streak_description"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak" />
        </receiver>

        <receiver
            android:name=".widget.DistanceReceiver"
            android:label="@string/widget_distance_description"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_distance" />
        </receiver>

        <!--
          The same widget in a row. A second receiver rather than a resize
          handle, because the picker is where somebody decides how much of their
          home screen a thing is worth.
        -->
        <receiver
            android:name=".widget.DistanceStripReceiver"
            android:label="@string/widget_distance_strip_description"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_distance_strip" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Location, for the distance feature.

      Capacitor's WebChromeClient answers the WebView's geolocation prompt by
      requesting the runtime permission — but it can only request what is
      declared here, so without these two lines `navigator.geolocation` fails
      silently in the app while working perfectly in the browser. That is a
      difference the PWA cannot show you and only a real device will.

      COARSE is what the feature actually runs on: positions are rounded to a
      ~11 km grid before they leave the phone. FINE is declared because both
      partners may opt into precise, and Android 12+ then lets them choose
      Approximate anyway from the system prompt — which the app handles, since
      any fix at all is more than the grid needs.

      Deliberately NOT declared: ACCESS_BACKGROUND_LOCATION. There is no
      background location in this app, by design, and asking for the permission
      would be the strongest possible signal that there is.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      The microphone, for voice notes.

      Exactly the same trap as the two lines above, found the same way and
      before a phone found it: `getUserMedia({ audio: true })` in a Capacitor
      WebView goes through the WebChromeClient, which can only ask for a runtime
      permission the manifest declares. Without this the composer would render,
      the button would depress, and the promise would reject with NotAllowedError
      — indistinguishable, from inside the app, from somebody having refused.
      And it would work perfectly in the PWA the whole time.

      Voice notes are the one feature in this app that needs a device to open
      before it is recording anything. Nothing here listens in the background,
      and there is no permission that would let it.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
      Asked for by the audio stack when a WebView opens a capture stream. It
      grants no access to anything and is not a runtime permission; leaving it
      out makes some devices refuse the stream with no error worth reading.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
