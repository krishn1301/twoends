<?xml version="1.0" encoding="utf-8"?>
<!--
  The wide one: one of you at each end, the distance in the gap.

  It was a 2x2 square, and on a real home screen that put both faces huddled in
  the middle of it with the width unused, under a label reading "apart" that
  said what the number already said. A widget about how far apart two people are
  should be the widest thing on the screen, and the gap between the two faces
  should be doing the talking.

  So: three cells by one, and the composable fills it as a row. `targetCellWidth`
  and `targetCellHeight` are API 31 attributes that older launchers ignore
  completely — on those only `minWidth` and `minHeight` are read and rounded up
  to whole cells on a grid that varies by device — so the two sets of numbers
  have to agree about the same shape rather than one correcting the other.

  **A widget already on a home screen does not resize itself when this changes.**
  An instance placed before this has to be removed and added again to take the
  new shape; the drawing adapts either way.

  `widget_distance_strip.xml` is the same widget offered smaller, for a row
  above the apps.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="80dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:minResizeWidth="180dp"
    android:minResizeHeight="60dp"
    android:description="@string/widget_distance_description"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewImage="@drawable/widget_preview_distance"
    android:initialLayout="@layout/glance_default_loading_layout" />
