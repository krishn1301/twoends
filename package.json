{
  "name": "twoends",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @twoends/web dev",
    "build": "pnpm --filter @twoends/web build",
    "preview": "pnpm --filter @twoends/web preview",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > packages/core/src/database.types.ts",
    "test:rls": "node scripts/rls.mjs",
    "verify": "pnpm check && pnpm test:rls",
    "devlink": "node scripts/devlink.mjs",
    "icons": "node scripts/icons.mjs",
    "widgets:art": "node scripts/widget-previews.mjs",
    "deploy": "node scripts/deploy.mjs",
    "db:seed": "node scripts/seed-prompts.mjs",
    "wipe:dev": "node scripts/wipe-dev.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.112.2",
    "@twoends/core": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.113.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
