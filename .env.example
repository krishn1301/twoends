# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# Dashboard → Project Settings → API

# Safe to ship in a client bundle. The anon key is public by design: every table
# is protected by row-level security, not by keeping this secret. That is exactly
# why the leak suite is non-negotiable — it tests the thing actually protecting
# the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER ships to a client, and never goes in the app bundle. This key bypasses
# every policy. It exists here for one reason: the leak suite uses it to seed the
# rows that the ordinary, policy-bound test clients then fail to read.
SUPABASE_SERVICE_ROLE_KEY=

# Guard rail. `pnpm test:rls` refuses to run unless this says `development`,
# because the suite creates and deletes users. Never set it on a project that
# holds a real couple's data.
SUPABASE_ENV=development
